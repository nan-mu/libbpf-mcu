# One graph for host BPF and ESP32-C3. Assembled by make/build.py.
# Placeholders: @...@

bpf_cflags = -O2 --target=bpf -Wall -Wno-missing-declarations -fno-stack-protector -g
bpf_includes = -I @ROOT@/include-bpf -include vmlinux.h

mcu_cflags = -O2 --target=riscv32-unknown-none-elf -march=rv32imc -mabi=ilp32 -nostdlib -ffreestanding -fno-builtin -fno-exceptions -fno-rtti -fno-jump-tables -fno-omit-frame-pointer -Wall -Wno-unused-function -g
mcu_includes = -I @ROOT@/include -include vmlinux.h
ldflags = -target riscv32-unknown-none-elf -nostdlib -fuse-ld=lld -Wl,-T,@LINKER@ -Wl

rule bpf_cc
    command = @CLANG@ -c -MD -MF $depfile $bpf_cflags $bpf_includes $in -o $out
    depfile = $depfile

rule mcu_cc
    command = @CLANG@ -c -MD -MF $depfile $mcu_cflags $mcu_includes $in -o $out
    depfile = $depfile

rule prevail
    command = @PYTHON@ @MAKE@/prevail_gate.py --obj $in --stamp $out
    description = PREVAIL $out
    restat = 1

rule link
    command = @CLANG@ $ldflags $in -o $out
    description = link $out

rule bin
    command = @OBJCOPY@ -O binary $in $out
    description = bin $out

rule report
    command = @PYTHON@ @MAKE@/obj_report.py --obj $in --src $src --out $out --objdump @OBJDUMP@ $report_flags
    description = report $out

rule tool
    command = CARGO_TARGET_DIR=@TOOLS_TARGET@ cargo build --manifest-path @TOOLS_MANIFEST@ --release --target @HOST_TRIPLE@ --bin xpost-mcu-elf
    description = TOOL xpost-mcu-elf
    restat = 1

rule pack
    command = @TOOL_BIN@ pack --image $image --bpf-toml $bpf_toml --name $name --slot-address $slot --helper-address $helper --machine $machine -o $out && @PYTHON@ @MAKE@/stamp_elf_size.py --report $report --elf $out
    description = pack $out

@EDGES@

default @DEFAULT@
